# ============================================================
# .env.example — Environment variable template
# ============================================================
# This file IS pushed to GitHub. It contains no real secrets.
# It shows every variable the app needs so new developers know
# exactly what to configure.
#
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your own values in the new .env file
#   3. Never push .env to GitHub
# ============================================================


# --- OLLAMA (Local AI Server) --------------------------------
# Address where Ollama is running on your machine.
# Default is localhost — only change if running on a remote server.
OLLAMA_BASE_URL=http://localhost:11434

# LLM model name to use for generating answers.
# Pull your chosen model first with: ollama pull <model_name>
# Example options: llama3.2, mistral, phi3
OLLAMA_MODEL=your_model_name_here

# Embedding model name for converting text to vectors.
# Must be the SAME model used in both ingestion and queries.
# Pull first with: ollama pull <model_name>
# Example: nomic-embed-text, mxbai-embed-large
EMBED_MODEL=your_embedding_model_here


# --- DATABASE (SQLite) ---------------------------------------
# File path for the SQLite database.
# Auto-created on first run. Stores staff, shifts, schedules.
DB_PATH=./data/workforce.db


# --- VECTOR DATABASE (ChromaDB) ------------------------------
# Folder path for ChromaDB vector storage.
# Auto-created during ingestion. Stores document chunks + vectors.
CHROMA_PATH=./data/chroma_db


# --- MLFLOW (Experiment Tracking) ----------------------------
# URL of the MLflow tracking server.
# Start it with: mlflow ui
# View runs at: http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000